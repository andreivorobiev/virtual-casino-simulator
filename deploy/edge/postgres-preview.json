{
  "schema": "casino.edge-policy.v1",
  "deployment_profile": "oci-postgres-preview",
  "stage": "repository-preparation-only",
  "canonical_origin": "https://preview.tiltseven.com",
  "canonical_host": "preview.tiltseven.com",
  "upstream": {
    "scheme": "http",
    "host": "127.0.0.1",
    "port": 8765
  },
  "ingress": {
    "public_tcp_ports": [80, 443],
    "protected_tcp_ports": [5432, 8765, 8877],
    "ssh_source_restricted": true
  },
  "access": {
    "manual_invites_only": true,
    "public_signup_enabled": false,
    "live_oauth_enabled": false,
    "admin_requires_authenticated_session": true
  },
  "proxy": {
    "request_headers": {
      "Host": "preview.tiltseven.com",
      "X-Forwarded-For": "$remote_addr",
      "X-Forwarded-Proto": "https"
    },
    "cleared_request_headers": [
      "Forwarded",
      "X-Forwarded-Host",
      "X-Forwarded-Port"
    ]
  },
  "acme": {
    "challenge": "http-01",
    "preflight_command": "nginx -t",
    "keep_current_certificate_on_failure": true
  },
  "monitoring": {
    "timeout_seconds": 5,
    "maximum_body_bytes": 65536,
    "minimum_certificate_days_remaining": 14,
    "authentication": {
      "preferred_header": "Authorization",
      "preferred_environment": "CASINO_EDGE_MONITOR_AUTHORIZATION",
      "fallback_cookie_environment": "CASINO_EDGE_MONITOR_COOKIE",
      "authenticated_paths": [
        "/readyz",
        "/api/v2/admin/operations"
      ]
    },
    "required_response_headers": {
      "Content-Security-Policy": "present",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "no-referrer",
      "X-Frame-Options": "DENY",
      "Strict-Transport-Security": "max-age=31536000"
    },
    "probes": [
      {
        "name": "liveness",
        "path": "/healthz",
        "authenticated": false,
        "expected_status": 200,
        "expected_json": {"status": "live"}
      },
      {
        "name": "readiness",
        "path": "/readyz",
        "authenticated": true,
        "expected_status": 200,
        "expected_json": {"ready": true, "storage_provider": "postgres"}
      },
      {
        "name": "admin_operations",
        "path": "/api/v2/admin/operations",
        "authenticated": true,
        "expected_status": 200,
        "expected_json": {"ready": true}
      }
    ]
  },
  "rollback": {
    "application_release": "atomic-symlink",
    "edge_configuration": "prevalidated-replacement",
    "database_rollback": "prohibited",
    "post_rollback_probe_required": true
  },
  "templates": {
    "nginx": "deploy/nginx/casino-postgres-preview.conf.template",
    "acme_renewal_hook": "deploy/acme/casino-renewal-hook.sh.template",
    "monitor_service": "deploy/systemd/casino-edge-monitor.service.template",
    "monitor_timer": "deploy/systemd/casino-edge-monitor.timer.template",
    "rollback": "deploy/rollback/casino-edge-rollback.sh.template"
  }
}
