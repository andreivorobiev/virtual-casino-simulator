# Repository-only nginx template for CORE-024; copying or enabling it requires a separate cutover approval.

# Keep the application upstream private to the host and reuse the supervised Gunicorn listener.
upstream casino_restricted_preview {
    server 127.0.0.1:8765;
    keepalive 8;
}

# Permit only the ACME HTTP-01 path over plaintext and redirect every other request to the exact origin.
server {
    listen 80;
    server_name casino.andvor.com;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root __ACME_CHALLENGE_ROOT__;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://casino.andvor.com$request_uri;
    }
}

# Terminate reviewed TLS and proxy the complete same-origin application to loopback only.
server {
    listen 443 ssl http2;
    server_name casino.andvor.com;
    server_tokens off;

    ssl_certificate __TLS_FULLCHAIN_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:casino_tls:10m;
    ssl_session_timeout 10m;

    client_max_body_size 1m;

    location / {
        proxy_http_version 1.1;
        proxy_pass http://casino_restricted_preview;
        proxy_set_header Connection "";
        proxy_set_header Host casino.andvor.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
