{
  "name": "virtual-casino-simulator-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor iOS and Android foundation for Virtual Casino Simulator issue #188.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "build:ci": "node scripts/build-web.mjs config/ci.example.json",
    "validate": "node --test tests/*.test.mjs",
    "check": "pnpm run validate && pnpm run sync:ci",
    "doctor": "cap doctor",
    "sync": "pnpm run build && cap sync",
    "sync:ci": "pnpm run build:ci && cap sync",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.3",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "esbuild": "0.28.1"
  }
}
