{
  "artifact": "restricted-preview-security",
  "version": 1,
  "stage": "restricted-preview",
  "canonical_origin": "https://casino.tiltseven.com",
  "anonymous_routes": [
    "/api/v2/auth/login",
    "/api/v2/auth/guest",
    "/api/v2/auth/redeem-invitation",
    "/api/v2/auth/enrollment-policy",
    "/api/v2/auth/signup",
    "/api/v2/auth/oauth/providers",
    "/api/v2/auth/oauth/{google|facebook}/start",
    "/api/v2/auth/oauth/{google|facebook}/callback",
    "/healthz"
  ],
  "authenticated_routes": [
    "/readyz"
  ],
  "admin_surfaces": [
    "/admin",
    "/admin.js",
    "/api/v2/admin/"
  ],
  "disabled_public_actions": [
    "enabled_signup",
    "oauth_exchange",
    "oauth_account_creation",
    "oauth_email_linking"
  ],
  "request_integrity": {
    "unsafe_methods": ["DELETE", "PATCH", "POST", "PUT"],
    "origin": "exact",
    "csrf": "per-session-distinct",
    "host": "exact-canonical-authority"
  },
  "proxy_policy": {
    "direct_peer": "one-configured-loopback-address",
    "accepted_headers": ["X-Forwarded-For", "X-Forwarded-Proto"],
    "forwarded_proto": "https",
    "reject_lists": true
  },
  "cookie_policy": {
    "host_only": true,
    "secure": true,
    "http_only_session": true,
    "same_site": ["Strict", "Lax"]
  },
  "access_policy": {
    "public_signup": false,
    "live_oauth": false,
    "oauth_provider_flags_default_false": true,
    "oauth_provider_network_release_flags_default_false": true,
    "oauth_existing_private_invite_accounts_only": true,
    "admin_requires_admin_session": true,
    "monitor_bearer_limited_to_operations": true,
    "guest_trials_restricted_preview_only": true,
    "guest_browser_context_proof_required": true,
    "guest_admin_telemetry_deidentified": true
  }
}
