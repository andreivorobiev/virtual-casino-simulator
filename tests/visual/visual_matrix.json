  "gates": [
    {
      "id": "VIS-COPY-001",
      "rule": "No resource keys, fallback identifiers, internal phase names, or debug labels are visible."
    },
    {
      "id": "VIS-TOKEN-001",
      "rule": "The current-user wallet has a reliable medallion, Play token balance label, numeric value, and no replacement-looking or currency glyph."
    },
    {
      "id": "VIS-TOKEN-002",
      "rule": "Visible copy uses play-token terminology and contains no real-money deposit, purchase, withdrawal, cash, or dollar framing."
    },
    {
      "id": "VIS-LAYOUT-001",
      "rule": "At desktop_primary the game stage is wider and visually stronger than both support rails combined."
    },
    {
      "id": "VIS-LAYOUT-002",
      "rule": "At desktop_primary the wallet, title and phase, primary wager selector, primary action, and full stage are visible without rail scrolling."
    },
    {
      "id": "VIS-LAYOUT-003",
      "rule": "No page-level horizontal overflow exists at any required viewport."
    },
    {
      "id": "VIS-SCROLL-001",
      "rule": "A desktop rail owns at most one intentional themed scroll surface and contains no nested primary scroll container."
    },
    {
      "id": "VIS-SCROLL-002",
      "rule": "Intentional scroll regions support keyboard focus, visible focus indication, wheel input, and touch panning."
    },
    {
      "id": "VIS-HIERARCHY-001",
      "rule": "Controls, player-facing status, and historical or statistical data use visually distinct regions."
    },
    {
      "id": "VIS-RESPONSIVE-001",
      "rule": "Tablet and mobile stacks contain no desktop-height empty tails, collisions, clipping, or unexplained wallet collapse."
    },
    {
      "id": "VIS-EVIDENCE-001",
      "rule": "Acceptance evidence is marked after_pass and records branch, commit, surface, state, locale, viewport, and path."
    },
    {
      "id": "VIS-CATALOG-001",
      "rule": "Catalog search, category filters, and restored game routes preserve accessible controls, readable cards, and the authenticated shared shell."
    }
  ],
