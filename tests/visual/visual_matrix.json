{
  "schema_version": 1,
  "authority": "docs/visual_design_standard.md",
  "evidence_classes": [
    "before_failure",
    "after_pass"
  ],
  "viewports": [
    {
      "id": "desktop_primary",
      "width": 1920,
      "height": 1080
    },
    {
      "id": "desktop_compact",
      "width": 1440,
      "height": 900
    },
    {
      "id": "tablet",
      "width": 1024,
      "height": 900
