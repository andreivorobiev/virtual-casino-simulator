{
  "module": "baccarat",
  "version": "9.1.16",
  "paths": [
    "casino/games/baccarat/",
    "web/games/baccarat.js"
  ],
  "requirements_prefixes": [
    "BAC"
  ],
  "contracts": [
    "contracts/openapi/baccarat.v1.yaml"
  ],
  "game": {
    "id": "baccarat",
    "rules": {
      "settings_route": "/api/v1/games/baccarat/settings",
      "defaults": "casino.games.baccarat.engine:default_state",
      "defaults_key": "rules",
      "fields": {
        "decks": {
          "kind": "int",
          "min": 1,
          "max": 8,
          "allocates": true
        },
        "tie_payout": {
          "kind": "enum",
          "values": [
            8,
            9
          ],
          "settles": true
        },
        "banker_commission": {
          "kind": "number",
          "min": 0,
          "max": 0.05,
          "settles": true
        },
        "tie_behavior": {
          "kind": "enum",
          "values": [
            "push"
          ]
        },
        "cut_cards_remaining": {
          "kind": "int",
          "min": 1,
          "max": 104,
          "default": 14,
          "allocates": true
        }
      }
    },
    "sort_order": 60,
    "route": "/games/baccarat",
    "label": "Baccarat",
    "category": "table",
    "categories": [
      "table",
      "cards",
      "roadmaps"
    ],
    "backend": {
      "register": "casino.games.baccarat.api:register"
    },
    "frontend": {
      "module": "./games/baccarat.js",
      "export": "BaccaratGame",
      "ready_testid": "baccarat-wager-setup",
      "i18n_domain": "games/baccarat",
      "i18n_probe": "shoe.cards"
    },
    "tests": {
      "long_driver": "tests.game_drivers.baccarat:play"
    },
    "translations": {
      "ru-RU": {
        "label": "Баккара",
        "kicker": "Стол",
        "description": "Пунто-банко с колодой, ставками Игрок, Банкир и Ничья, ботами и историей дорог.",
        "tags": [
          "Боты",
          "Автоигра",
          "Статистика"
        ]
      }
    },
    "lobby": {
      "featured": false,
      "wide": false,
      "art_class": "baccarat-art",
      "symbol": "&#9827;",
      "kicker": "Table",
      "description": "Punto Banco shoe with burn/cut behavior, Player/Banker/Tie bets, bots, and road history.",
      "tags": [
        "Bots",
        "Autoplay",
        "Stats"
      ]
    }
  },
  "depends_on": [
    "core",
    "ledger",
    "players",
    "autoplay"
  ],
  "may_not_depend_on": [
    "roulette",
    "slots",
    "blackjack",
    "keno",
    "bingo"
  ]
}
