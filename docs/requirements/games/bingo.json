        "web/i18n/ru-RU/games/bingo.json"
      ],
      "introduced_in": "issues-576-577-bingo-lifecycle",
      "changed_in": "issues-576-577-bingo-lifecycle",
      "notes": "The existing server refund-before-first-call and abandon-after-call economics remain authoritative."
    }
