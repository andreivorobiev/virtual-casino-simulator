    {
      "id": "BINGO-025",
      "module": "Bingo",
      "description": "Bingo sessions seat ledger-funded bot competitor cards and bound calls per pattern, ending as no_win with no payout at the cap, so a session has a real losing outcome, calls are never unbounded, and bot wins pay bot wallets.",
      "status": "PASS",
      "api_tests": [
        "API-BINGO-ECONOMICS-001"
      ],
      "browser_tests": [],
      "implementation_files": [
        "casino/games/bingo/api.py",
        "casino/games/bingo/engine.py"
      ],
      "introduced_in": "issue-405-bingo-economics",
      "changed_in": "issue-452-bingo-paytable",
      "notes": "Unfilled competitor seats are now filled with synthetic house spoiler cards so the field is always full; persisted pre-cap sessions migrate to the default cap on load. The formerly player-positive paytable was rebalanced house-side under issue #452 (see BINGO-026)."
    },
    {
      "id": "BINGO-026",
      "module": "Bingo",
      "description": "Every Bingo pattern pays roughly 0.9 divided by its measured win probability at the guaranteed four-card field, giving each pattern a modest single-digit-to-low-double-digit house edge instead of the prior player-positive returns, and the competitor field is always seated at full strength with synthetic house spoiler cards that end sessions but are never credited.",
      "status": "PASS",
      "api_tests": [
        "API-BINGO-ECONOMICS-001"
      ],
      "browser_tests": [],
      "implementation_files": [
        "casino/games/bingo/engine.py",
        "casino/games/bingo/api.py",
        "tests/bingo_economics_tests.py"
      ],
      "introduced_in": "issue-452-bingo-paytable",
      "changed_in": "issue-452-bingo-paytable",
      "notes": "Multipliers line 3.4, four_corners 6.3, postage_stamp 3.5, and blackout 650 were derived from seeded simulation evidence over the production pattern evaluator. House spoiler cards carry no wallet and are skipped by settlement, so an uncharged card can never collect and the guaranteed field remains house-sided when no configured bot can fund a seat."
    },
    {
      "id": "BINGO-027",
      "module": "Bingo",
      "description": "Bingo autoplay defaults to one complete bounded 75-call plan, including for disposable guests, and resetting a called session requires explicit non-refund confirmation followed by truthful refunded, abandoned, or cleared feedback.",
      "status": "PASS",
      "api_tests": [
        "API-BINGO-001"
      ],
      "browser_tests": [
        "BR-BINGO-001"
      ],
