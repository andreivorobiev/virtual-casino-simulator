# Python interpreter caches generated by validation and local runs.
__pycache__/
*.py[cod]
*$py.class

# Python test, packaging, and environment artifacts.
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/

# JavaScript dependency installs and local browser automation artifacts.
node_modules/
playwright-report/
test-results/

# Local logs generated by application and test runs.
logs/
*.log

# Local OS/editor noise.
.DS_Store
Thumbs.db

# Local runtime secrets; checked-in examples remain visible and reviewable.
.env
.env.*
!.env.example
!.env.*.example
oci_api_key*.pem
oci_api_key*.key
id_rsa*
id_ed25519*

# Terraform local state and secret variable values; example variable files remain tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
!*.tfvars.example
