# Python interpreter caches generated by validation and local runs.
__pycache__/
*.py[cod]
*$py.class

# Python test, packaging, and environment artifacts.
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.venv/
venv/

# JavaScript dependency installs and local browser automation artifacts.
node_modules/
playwright-report/
test-results/

# Local logs generated by application and test runs.
logs/
*.log

# Local OS/editor noise.
.DS_Store
Thumbs.db

# Local runtime secrets; checked-in examples remain visible and reviewable.
.env
.env.*
!.env.example
!.env.*.example
oci_api_key*.pem
oci_api_key*.key
id_rsa*
id_ed25519*

# Terraform local state and secret variable values; example variable files remain tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
!*.tfvars.example

# Local runtime state written by the running application. These are generated on first run from
# defaults in casino/core (see players.default_players and ensure_dirs), so they are outputs rather
# than sources. Tracking them meant every local run dirtied the working tree, invited accidental
# commits of live wallet state, and put data/auth/sessions.json - which holds plaintext session
# bearer tokens - one `git add -A` away from being published. (issue #419)
data/
